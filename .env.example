# Copy to .env.local for local development. Never commit real values.

# --- API (Go) ---
PORT=8080
# Library dataset (the SMB share). Locally: a throwaway folder.
LIBRARY_PATH=./.dev/library
# App state: SQLite database and image cache.
DATA_PATH=./.dev/data
# IGDB / Twitch developer credentials (use separate dev and prod apps).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# argon2id hash of the login password (generated by a helper in phase 1).
APP_PASSWORD_HASH=
# Random 32+ byte secret used to sign session cookies.
SESSION_SECRET=
# File ownership for files written to the library (match the SMB dataset owner).
PUID=1000
PGID=1000
UMASK=002
TRASH_RETENTION_DAYS=30
EXTRACT_CONCURRENCY=1

# --- Web (Vite) ---
# api  = talk to the Go backend (local, production)
# demo = no backend, everything simulated in the browser (Vercel)
VITE_DATA_SOURCE=api
