# Copy to .env.local for local development (Task loads it). Never commit real values.
# `task dev:api` works without this file using safe dev defaults (password: gameexplorer).

# --- API (Go) ---
PORT=8080
# Library dataset (the SMB share) and app state (SQLite + image cache).
# In local development compose.dev.yaml maps both to ./.dev/.
LIBRARY_PATH=/library
DATA_PATH=/data

# Shared login password: set ONE of these.
# APP_PASSWORD_HASH is recommended: echo "my password" | task hash-password
APP_PASSWORD_HASH=
# Plain alternative, hashed in memory at startup (handy on TrueNAS).
APP_PASSWORD=

# Random secret of 32+ bytes used to sign session cookies. Changing it logs out every device.
SESSION_SECRET=
# Session lifetime per device (Go duration).
SESSION_TTL=720h
# true only when served over HTTPS.
COOKIE_SECURE=false

# IGDB / Twitch developer credentials (optional: without them there are no name
# suggestions or covers; use separate dev and prod apps).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# debug | info | warn | error
LOG_LEVEL=info

# File ownership on TrueNAS comes from the container user (compose `user:`) and
# the dataset ACL, not from the app. Give that user a Modify ACL entry.
PUID=3000
PGID=3000

TRASH_RETENTION_DAYS=30
EXTRACT_CONCURRENCY=1
# How often the library is scanned for changes made over SMB (Go duration, 1m or more).
LIBRARY_SCAN_INTERVAL=15m

# Fixed extensions of each console (comma separated). Empty keeps the defaults
# below; extensions added from the app come on top and can be removed there.
SWITCH_EXTENSIONS=.nsp,.xci
WII_EXTENSIONS=.iso,.wbfs,.rvz,.nkit.iso
PSP_EXTENSIONS=.iso,.cso

# --- Web (Vite) ---
# api  = talk to the Go backend (local, production)
# demo = no backend, everything simulated in the browser (Vercel)
VITE_DATA_SOURCE=api
