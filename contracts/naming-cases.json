{
  "description": "Expected folder and file names (spec §5). sanitizedTitle is the game folder; fileName is relative to it. kind is base, update or dlc (Switch) or game (Wii, PSP); label is what the user typed (version or DLC name). extensionCases pick a file's extension: the longest known one it ends with. expected.error names the rejected field.",
  "cases": [
    {
      "name": "base game carries its tag",
      "input": { "title": "Limbo", "kind": "base", "extension": ".xci" },
      "expected": { "sanitizedTitle": "Limbo", "fileName": "Limbo [BASE].xci" }
    },
    {
      "name": "update carries its version with one v",
      "input": { "title": "Limbo", "kind": "update", "label": "122345", "extension": ".nsp" },
      "expected": { "sanitizedTitle": "Limbo", "fileName": "Limbo [UPDATE v122345].nsp" }
    },
    {
      "name": "a typed v is not doubled",
      "input": { "title": "Limbo", "kind": "update", "label": " v1.0.4 ", "extension": ".nsp" },
      "expected": { "sanitizedTitle": "Limbo", "fileName": "Limbo [UPDATE v1.0.4].nsp" }
    },
    {
      "name": "dlc carries its name",
      "input": { "title": "Limbo", "kind": "dlc", "label": "Fuga Maestra", "extension": ".nsp" },
      "expected": { "sanitizedTitle": "Limbo", "fileName": "Limbo [DLC Fuga Maestra].nsp" }
    },
    {
      "name": "the dlc name is sanitized too",
      "input": { "title": "Limbo", "kind": "dlc", "label": "Pack: 1/2", "extension": ".nsp" },
      "expected": { "sanitizedTitle": "Limbo", "fileName": "Limbo [DLC Pack - 1 2].nsp" }
    },
    {
      "name": "wii and psp files are named after the game",
      "input": { "title": "Ōkami", "kind": "game", "extension": ".nkit.iso" },
      "expected": { "sanitizedTitle": "Ōkami", "fileName": "Ōkami.nkit.iso" }
    },
    {
      "name": "colon becomes space-dash",
      "input": {
        "title": "The Legend of Zelda: Tears of the Kingdom",
        "kind": "base",
        "extension": ".xci"
      },
      "expected": {
        "sanitizedTitle": "The Legend of Zelda - Tears of the Kingdom",
        "fileName": "The Legend of Zelda - Tears of the Kingdom [BASE].xci"
      }
    },
    {
      "name": "forbidden characters are dropped",
      "input": {
        "title": "What?! <Bad> \"Name\" | A/B \\ C*",
        "kind": "game",
        "extension": ".iso"
      },
      "expected": {
        "sanitizedTitle": "What! Bad Name A B C",
        "fileName": "What! Bad Name A B C.iso"
      }
    },
    {
      "name": "trailing dots and spaces are trimmed",
      "input": { "title": "Shadow of the Colossus... ", "kind": "game", "extension": ".iso" },
      "expected": {
        "sanitizedTitle": "Shadow of the Colossus",
        "fileName": "Shadow of the Colossus.iso"
      }
    },
    {
      "name": "whitespace collapses",
      "input": {
        "title": "  God of War:\tGhost   of Sparta ",
        "kind": "game",
        "extension": ".cso"
      },
      "expected": {
        "sanitizedTitle": "God of War - Ghost of Sparta",
        "fileName": "God of War - Ghost of Sparta.cso"
      }
    },
    {
      "name": "windows colon substitute and trademark",
      "input": { "title": "Animal Crossing™꞉ New Horizons", "kind": "base", "extension": ".nsp" },
      "expected": {
        "sanitizedTitle": "Animal Crossing™ - New Horizons",
        "fileName": "Animal Crossing™ - New Horizons [BASE].nsp"
      }
    },
    {
      "name": "extension is lower-cased",
      "input": { "title": "Metroid Prime", "kind": "game", "extension": ".ISO" },
      "expected": { "sanitizedTitle": "Metroid Prime", "fileName": "Metroid Prime.iso" }
    },
    {
      "name": "update without version",
      "input": { "title": "Limbo", "kind": "update", "label": "  ", "extension": ".nsp" },
      "expected": { "error": "version" }
    },
    {
      "name": "version with letters",
      "input": { "title": "Limbo", "kind": "update", "label": "1.0 beta", "extension": ".nsp" },
      "expected": { "error": "version" }
    },
    {
      "name": "dlc without name",
      "input": { "title": "Limbo", "kind": "dlc", "label": "???", "extension": ".nsp" },
      "expected": { "error": "label" }
    },
    {
      "name": "title with nothing left",
      "input": { "title": "???", "kind": "game", "extension": ".iso" },
      "expected": { "error": "title" }
    }
  ],
  "extensionCases": [
    {
      "name": "Ookami (USA).nkit.iso",
      "known": [".iso", ".nkit.iso", ".cso"],
      "expected": ".nkit.iso"
    },
    { "name": "Daxter.ISO", "known": [".iso", ".nkit.iso"], "expected": ".iso" },
    { "name": "Limbo.xci", "known": [".nsp", ".iso"], "expected": "" },
    { "name": ".iso", "known": [".iso"], "expected": "" }
  ]
}
